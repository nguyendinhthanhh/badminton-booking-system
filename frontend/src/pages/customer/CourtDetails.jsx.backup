import { useParams, Link, useNavigate } from 'react-router-dom';
import { useState, useEffect, useMemo } from 'react';
import courtService from '../../services/courtService';
import bookingService from '../../services/bookingService';
import Toast from '../../components/common/Toast';

const CourtDetails = () => {
  const { id } = useParams();
  const navigate = useNavigate();
  const [court, setCourt] = useState(null);
  const [courtDetail, setCourtDetail] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [selectedDate, setSelectedDate] = useState(new Date());
  const [loadingDetail, setLoadingDetail] = useState(false);
  const [selectedTimeRanges, setSelectedTimeRanges] = useState([]);
  const [bookingInProgress, setBookingInProgress] = useState(false);
  const [toast, setToast] = useState({ show: false, message: '', type: '' });

  useEffect(() => {
    fetchCourtDetails();
  }, [id]);

  useEffect(() => {
    if (court) {
      fetchCourtDetailByDate();
    }
  }, [court, selectedDate]);

  const fetchCourtDetails = async () => {
    try {
      setLoading(true);
      const data = await courtService.getCourtById(id);
      setCourt(data);
    } catch (err) {
      setError('Không thể tải thông tin sân. Vui lòng thử lại sau.');
      console.error('Error fetching court details:', err);
    } finally {
      setLoading(false);
    }
  };

  const fetchCourtDetailByDate = async () => {
    try {
      setLoadingDetail(true);
      const formattedDate = formatDateString(selectedDate);
      const data = await courtService.getCourtDetailByDate(id, formattedDate);
      setCourtDetail(data);
      setSelectedTimeRanges([]);
    } catch (err) {
      console.error('Error fetching court detail by date:', err);
    } finally {
      setLoadingDetail(false);
    }
  };

  const getDayType = (date) => {
    const day = date.getDay();
    return (day === 0 || day === 6) ? 'WEEKEND' : 'WEEKDAY';
  };

  const getPriceRanges = () => {
    if (!courtDetail) return [];
    const dayType = getDayType(selectedDate);
    return dayType === 'WEEKEND' ? courtDetail.weekendPrices : courtDetail.weekdayPrices;
  };

  const toggleTimeRangeSelection = (range) => {
    setSelectedTimeRanges(prev => {
      const exists = prev.find(r => r.startTime === range.startTime && r.endTime === range.endTime);
      if (exists) {
        return prev.filter(r => !(r.startTime === range.startTime && r.endTime === range.endTime));
      } else {
        return [...prev, range];
      }
    });
  };

  const isRangeSelected = (range) => {
    return selectedTimeRanges.some(r => r.startTime === range.startTime && r.endTime === range.endTime);
  };

  const showToast = (message, type) => {
    setToast({ show: true, message, type });
  };

  const handleBooking = async () => {
    if (selectedTimeRanges.length === 0) {
      showToast('Vui lòng chọn ít nhất một khung giờ', 'error');
      return;
    }

    // TODO: Get userId from auth context/store
    const userId = 1; // Temporary hardcoded

    try {
      setBookingInProgress(true);

      // Tính startTime và endTime từ các khung giờ đã chọn
      const sortedRanges = [...selectedTimeRanges].sort((a, b) => 
        a.startTime.localeCompare(b.startTime)
      );
      
      const startTimeStr = sortedRanges[0].startTime; // "06:00"
      const endTimeStr = sortedRanges[sortedRanges.length - 1].endTime; // "22:00"

      // Convert "HH:mm" to time object
      const parseTime = (timeStr) => {
        const [hour, minute] = timeStr.split(':').map(Number);
        return {
          hour: hour,
          minute: minute,
          second: 0,
          nano: 0
        };
      };

      const bookingData = {
        courtId: parseInt(id),
        playDate: formatDateString(selectedDate),
        startTime: parseTime(startTimeStr),
        endTime: parseTime(endTimeStr),
        notes: `Đặt ${selectedTimeRanges.length} khung giờ`
      };

      const response = await bookingService.createBooking(userId, bookingData);
      
      showToast('Đặt sân thành công! Mã booking: #' + response.bookingId, 'success');
      
      // Reset selection và refresh availability
      setSelectedTimeRanges([]);
      fetchCourtDetailByDate();

      // Navigate to booking confirmation or user bookings page after 2s
      setTimeout(() => {
        navigate('/bookings');
      }, 2000);

    } catch (error) {
      console.error('Booking error:', error);
      const errorMessage = error.response?.data?.message || 'Đặt sân thất bại. Vui lòng thử lại.';
      showToast(errorMessage, 'error');
    } finally {
      setBookingInProgress(false);
    }
  };

  const formatDateString = (date) => {
    return date.toISOString().split('T')[0];
  };

  const getDayName = (date) => {
    const days = ['CN', 'Th 2', 'Th 3', 'Th 4', 'Th 5', 'Th 6', 'Th 7'];
    return days[date.getDay()];
  };

  const getWeekDays = useMemo(() => {
    const days = [];
    const today = new Date();
    for (let i = 0; i < 7; i++) {
      const date = new Date(today);
      date.setDate(today.getDate() + i);
      days.push(date);
    }
    return days;
  }, []);

  const totalPrice = useMemo(() => {
    return selectedTimeRanges.reduce((sum, range) => {
      return sum + (range.pricePerHour || 0);
    }, 0);
  }, [selectedTimeRanges]);

  const minPrice = court?.minPricePerHour || 0;
  const maxPrice = court?.maxPricePerHour || 0;

  const selectedRangesInfo = useMemo(() => {
    return selectedTimeRanges;
  }, [selectedTimeRanges]);

  if (loading) {
    return <div className="min-h-screen bg-[#f9fafb] flex items-center justify-center">Loading...</div>;
  }

  if (error || !court) {
    return <div className="min-h-screen bg-[#f9fafb] flex items-center justify-center">{error || 'Sân không tồn tại'}</div>;
  }

  return (
    <div className="min-h-screen bg-[#f9fafb] font-sans text-slate-800">
      {/* Breadcrumbs */}
      <div className="max-w-[1240px] mx-auto px-4 py-4">
        <div className="flex items-center gap-2 text-xs text-gray-500 mb-4">
          <Link to="/" className="hover:text-blue-600 transition-colors">Trang chủ</Link>
          <span>›</span>
          <Link to="/courts" className="hover:text-blue-600 transition-colors">TP. Hồ Chí Minh</Link>
          <span>›</span>
          <span className="text-gray-900 font-medium">{court.name}</span>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-12 gap-8">
          {/* LEFT: Main Content */}
          <div className="lg:col-span-8">
            {/* Gallery Grid */}
            <div className="grid grid-cols-12 gap-2 mb-6 h-[400px]">
              <div className="col-span-8 h-full rounded-l-2xl overflow-hidden shadow-sm">
                <img src={court.imageUrl || 'https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?w=800'} className="w-full h-full object-cover" alt={court.name} />
              </div>
              <div className="col-span-4 flex flex-col gap-2 h-full">
                <div className="h-1/2 rounded-tr-2xl overflow-hidden shadow-sm">
                  <img src="https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?w=400" className="w-full h-full object-cover" alt="Detail 1" />
                </div>
                <div className="h-1/2 rounded-br-2xl overflow-hidden relative shadow-sm">
                  <img src="https://images.unsplash.com/photo-1626224583764-f87db24ac4ea?w=400" className="w-full h-full object-cover" alt="Detail 2" />
                  <div className="absolute inset-0 bg-black/40 flex items-center justify-center text-white font-bold text-lg pointer-events-none">
                    +12 ảnh
                  </div>
                </div>
              </div>
            </div>

            {/* Court Basic Info */}
            <div className="flex justify-between items-start mb-6">
              <div>
                <h1 className="text-2xl font-black text-gray-900 mb-2 uppercase tracking-tight">{court.name} - Sân {court.id}</h1>
                <div className="flex items-center gap-6 text-sm">
                  <div className="flex items-center gap-1">
                    <span className="material-symbols-outlined text-yellow-500 fill-current text-lg">star</span>
                    <span className="font-bold text-gray-900">4.8</span>
                    <span className="text-gray-400 font-medium">(120 đánh giá)</span>
                  </div>
                  <div className="flex items-center gap-1.5 text-gray-500">
                    <span className="material-symbols-outlined text-gray-400 text-lg">location_on</span>
                    <span className="font-medium">{court.location || 'Quận 1, TP. Hồ Chí Minh'}</span>
                  </div>
                </div>
              </div>
              <div className="text-right">
                <p className="text-gray-400 text-xs font-bold uppercase mb-1">Giá từ</p>
                <div className="flex items-baseline gap-1">
                  {minPrice > 0 && maxPrice > 0 ? (
                    <>
                      <span className="text-2xl font-black text-blue-600">
                        {minPrice.toLocaleString()}đ
                      </span>
                      {minPrice !== maxPrice && (
                        <>
                          <span className="text-gray-400 font-bold">-</span>
                          <span className="text-2xl font-black text-blue-600">
                            {maxPrice.toLocaleString()}đ
                          </span>
                        </>
                      )}
                    </>
                  ) : (
                    <span className="text-gray-400 text-sm italic">Đang tải giá...</span>
                  )}
                  <span className="text-gray-400 font-bold text-xs uppercase">/giờ</span>
                </div>
              </div>
            </div>

            {/* Tabs */}
            <div className="flex gap-8 border-b border-gray-100 mb-8">
              <button className="pb-3 text-sm font-bold text-blue-600 border-b-2 border-blue-600 px-1">Đặt sân</button>
              <button className="pb-3 text-sm font-bold text-gray-400 hover:text-gray-600 px-1">Thông tin</button>
              <button className="pb-3 text-sm font-bold text-gray-400 hover:text-gray-600 px-1">Đánh giá</button>
            </div>

            {/* Date Selection */}
            <div className="mb-10">
              <h3 className="text-base font-black text-gray-900 mb-4">Chọn ngày đặt sân</h3>
              <div className="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
                {getWeekDays.map((date, idx) => {
                  const isActive = formatDateString(date) === formatDateString(selectedDate);
                  return (
                    <button
                      key={idx}
                      onClick={() => setSelectedDate(date)}
                      className={`min-w-[64px] flex flex-col items-center py-2.5 rounded-xl border transition-all ${isActive
                        ? 'bg-blue-50 border-blue-600 ring-1 ring-blue-600'
                        : 'bg-white border-gray-100 hover:border-blue-300'
                        }`}
                    >
                      <span className={`text-[10px] font-bold uppercase mb-1 ${isActive ? 'text-blue-600' : 'text-gray-400'}`}>{getDayName(date)}</span>
                      <span className={`text-xl font-black ${isActive ? 'text-blue-600' : 'text-gray-900'}`}>{date.getDate()}</span>
                      <span className="text-[10px] font-bold text-gray-400 uppercase">Th {date.getMonth() + 1}</span>
                    </button>
                  );
                })}
              </div>
            </div>

            {/* Time Selection */}
            <div className="mb-10">
              <div className="flex justify-between items-center mb-5">
                <h3 className="text-base font-black text-gray-900">
                  Chọn khung giờ ({court?.openTime} - {court?.closeTime})
                </h3>
                <div className="flex gap-4 text-[10px] font-bold uppercase tracking-wider">
                  <div className="flex items-center gap-1.5"><span className="size-3 rounded border border-[#13ec49] bg-green-50"></span> Trống</div>
                  <div className="flex items-center gap-1.5"><span className="size-3 rounded bg-blue-600"></span> Đang chọn</div>
                  <div className="flex items-center gap-1.5"><span className="size-3 rounded bg-gray-100"></span> Đã đặt</div>
                </div>
              </div>

              {loadingDetail ? (
                <div className="grid grid-cols-2 md:grid-cols-3 gap-3 animate-pulse">
                  {[1, 2, 3, 4, 5, 6].map(i => <div key={i} className="h-20 bg-gray-100 rounded-xl"></div>)}
                </div>
              ) : (
                <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
                  {getPriceRanges().map((range, idx) => {
                    const isSelected = isRangeSelected(range);
                    const isBooked = range.status === 'BOOKED';
                    return (
                      <button
                        key={idx}
                        disabled={isBooked}
                        onClick={() => toggleTimeRangeSelection(range)}
                        className={`group relative h-20 rounded-xl border flex flex-col items-center justify-center transition-all ${
                          isSelected
                            ? 'bg-blue-600 border-blue-600 shadow-md shadow-blue-200'
                            : isBooked
                            ? 'bg-gray-100 border-transparent cursor-not-allowed opacity-80'
                            : 'bg-green-50/30 border-[#13ec49] hover:bg-green-50 hover:shadow-sm'
                        }`}
                      >
                        <span className={`text-xs font-bold mb-0.5 ${
                          isSelected ? 'text-blue-100' : isBooked ? 'text-gray-400' : 'text-gray-500'
                        }`}>
                          {range.periodName}
                        </span>
                        <span className={`text-sm font-black ${
                          isSelected ? 'text-white' : isBooked ? 'text-gray-400' : 'text-gray-900'
                        }`}>
                          {range.startTime.substring(0, 5)} - {range.endTime.substring(0, 5)}
                        </span>
                        <span className={`text-[10px] font-bold ${
                          isSelected ? 'text-blue-100' : isBooked ? 'text-gray-400' : 'text-[#13ec49]'
                        }`}>
                          {isBooked ? 'Đã đặt' : `${range.pricePerHour.toLocaleString()}đ/giờ`}
                        </span>
                      </button>
                    );
                  })}
                </div>
              )}
            </div>

            {/* Amenities Section */}
            <div className="bg-white rounded-2xl border border-gray-100 p-6 shadow-sm mb-12">
              <h3 className="text-base font-black text-gray-900 mb-6">Tiện ích đi kèm</h3>
              <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                {[
                  { icon: 'p', label: 'Gửi xe miễn phí' },
                  { icon: 'wifi', label: 'Wifi miễn phí' },
                  { icon: 'shower', label: 'Phòng tắm' },
                  { icon: 'sports_tennis', label: 'Cho thuê vợt' }
                ].map((item, idx) => (
                  <div key={idx} className="flex items-center gap-3">
                    <div className="size-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600">
                      {item.icon === 'p' ? <span className="font-black text-xl">P</span> : <span className="material-symbols-outlined text-xl">{item.icon}</span>}
                    </div>
                    <span className="text-xs font-bold text-gray-700">{item.label}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          {/* RIGHT: Booking Sidebar */}
          <div className="lg:col-span-4 lg:sticky lg:top-24 self-start">
            <div className="bg-white rounded-[2rem] border border-gray-100 shadow-xl shadow-gray-200/50 p-8">
              <h2 className="text-xl font-black text-gray-900 mb-8">Thông tin đặt sân</h2>

              <div className="space-y-6 mb-10">
                <div className="flex justify-between items-center">
                  <span className="text-sm font-bold text-gray-500">Ngày đặt:</span>
                  <span className="text-sm font-black text-gray-900">
                    {getDayName(selectedDate)}, {selectedDate.getDate()}/{selectedDate.getMonth() + 1}/{selectedDate.getFullYear()}
                  </span>
                </div>

                <div className="space-y-2">
                  <p className="text-sm font-bold text-gray-500">Khung giờ đã chọn:</p>
                  <div className="flex flex-wrap gap-2">
                    {selectedRangesInfo.length > 0 ? (
                      selectedRangesInfo.map((range, idx) => (
                        <span key={idx} className="px-3 py-1 bg-blue-50 text-blue-600 rounded-lg text-[10px] font-black uppercase tracking-wider border border-blue-100">
                          {range.startTime.substring(0, 5)} - {range.endTime.substring(0, 5)}
                        </span>
                      ))
                    ) : (
                      <span className="text-xs text-gray-400 italic font-medium">Chưa có khung giờ nào được chọn</span>
                    )}
                  </div>
                </div>

                <div className="pt-6 border-t border-dashed border-gray-100 space-y-3">
                  <div className="flex justify-between items-center text-xs font-bold text-gray-500">
                    <span>Tiền sân ({selectedTimeRanges.length} khung giờ)</span>
                    <span className="text-gray-900">{totalPrice.toLocaleString()}đ</span>
                  </div>
                  <div className="flex justify-between items-center text-xs font-bold text-gray-500">
                    <span>Phí dịch vụ</span>
                    <span className="text-gray-900">{selectedTimeRanges.length > 0 ? '10.000đ' : '0đ'}</span>
                  </div>
                </div>

                <div className="pt-6 border-t-2 border-slate-900 flex justify-between items-center">
                  <span className="text-base font-black text-gray-900">Tổng thanh toán</span>
                  <span className="text-2xl font-black text-blue-600">
                    {selectedTimeRanges.length > 0 ? (totalPrice + 10000).toLocaleString() : '0'}đ
                  </span>
                </div>
              </div>

              <button
                disabled={selectedTimeRanges.length === 0 || bookingInProgress}
                onClick={handleBooking}
                className={`w-full h-14 rounded-2xl flex items-center justify-center gap-2 text-base font-black transition-all ${
                  selectedTimeRanges.length > 0 && !bookingInProgress
                    ? 'bg-blue-600 text-white hover:bg-blue-700 shadow-lg shadow-blue-200'
                    : 'bg-gray-100 text-gray-400 cursor-not-allowed'
                }`}
              >
                {bookingInProgress ? (
                  <>
                    <span className="animate-spin material-symbols-outlined">progress_activity</span>
                    Đang xử lý...
                  </>
                ) : (
                  <>
                    Tiếp tục đặt sân
                    <span className="material-symbols-outlined font-black">arrow_forward</span>
                  </>
                )}
              </button>

              <div className="mt-6 flex items-start gap-3 bg-blue-50/50 p-4 rounded-2xl border border-blue-100">
                <span className="material-symbols-outlined text-blue-600 text-lg">info</span>
                <p className="text-[10px] font-bold text-blue-800 leading-relaxed">
                  Vui lòng có mặt tại sân ít nhất 5 phút trước giờ đã đặt. Bạn có thể huỷ đặt sân trước 24h.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <style>{`
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
      `}</style>

      {/* Toast */}
      {toast.show && (
        <Toast
          message={toast.message}
          type={toast.type}
          onClose={() => setToast({ show: false, message: '', type: '' })}
        />
      )}
    </div>
  );
};

export default CourtDetails;
